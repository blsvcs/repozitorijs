{
  "name": "Nolemumi pilot",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && pip install streamlit pandas",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit nolēmumu meklētājs",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
